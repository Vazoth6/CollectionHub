@page "/Inventory"
@model CollectionHub.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = Model.IsBuyerProfile ? "Perfil de Comprador" : "Perfil de Vendedor";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h1 class="display-5 mb-2">
                    <i class="bi @(Model.IsBuyerProfile ? "bi-bag-check text-success" : "bi-shop text-primary")"></i>
                    Perfil de @Model.ActiveProfile
                </h1>
                <p class="text-muted mb-0">
                    @(Model.IsBuyerProfile
                        ? "Neste perfil consegue ver a sua coleção e colocar itens à venda."
                        : "Neste perfil só consegue ver as suas vendas.")
                </p>
            </div>

<div class="d-flex align-items-center gap-2">

    @if (Model.IsBuyerProfile)
    {
        <form method="post" asp-page="/Profile/Switch">
            <input type="hidden" name="profile" value="Vendedor" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-arrow-repeat"></i>
                Mudar para Vendedor
            </button>
        </form>
    }
    else
    {
                    <div class="d-flex align-items-center gap-2">

                        @if (Model.IsBuyerProfile)
                        {
                            <form method="post" asp-page="/Profile/Switch">
                                <input type="hidden" name="profile" value="Vendedor" />
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-arrow-repeat"></i>
                                    Mudar para Vendedor
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page="/Profile/Switch">
                                <input type="hidden" name="profile" value="Comprador" />
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-arrow-repeat"></i>
                                    Mudar para Comprador
                                </button>
                            </form>
                        }

                    </div>
    }

</div>

            <hr class="w-100" />
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-info bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Saldo Disponível</h6>
                            <h2 class="mb-0 text-success">@Model.WalletBalance.ToString("C")</h2>
                        </div>
                        <i class="bi bi-wallet2 fs-1 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.IsBuyerProfile)
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-success bg-opacity-10">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Itens na Coleção</h6>
                                <h2 class="mb-0 text-success">@Model.ItemsPurchased.Count</h2>
                            </div>
                            <i class="bi bi-check-circle fs-1 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-md-4">
                <div class="card shadow-sm border-0 bg-primary bg-opacity-10">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="text-muted mb-1">Itens à Venda</h6>
                                <h2 class="mb-0 text-primary">@Model.ItemsForSale.Count</h2>
                            </div>
                            <i class="bi bi-tag fs-1 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-secondary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Transações</h6>
                            <h2 class="mb-0 text-secondary">@Model.Transactions.Count</h2>
                        </div>
                        <i class="bi bi-receipt fs-1 text-secondary"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsBuyerProfile)
    {
        <h3 class="mb-3"><i class="bi bi-bag-check"></i> A minha coleção</h3>

        @if (!Model.ItemsPurchased.Any())
        {
            <div class="alert alert-info text-center py-5">
                <i class="bi bi-inbox fs-1"></i>
                <h4 class="mt-2">Nenhum item na coleção</h4>
                <p>Visite a <a href="/Shop">Loja</a> para comprar itens.</p>
            </div>
        }
        else
        {
            <div class="row g-4 mb-5">
                @foreach (var item in Model.ItemsPurchased)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="item-image">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" />
                                }
                                else
                                {
                                    <div class="image-placeholder"><i class="bi bi-box-seam"></i></div>
                                }
                                <span class="item-badge badge bg-success">Na Coleção</span>
                            </div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text text-muted">@item.Description</p>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-primary">@item.Price.ToString("C")</span>
                                    @if (item.PurchaseDate.HasValue)
                                    {
                                        <small class="text-muted">@item.PurchaseDate?.ToString("dd/MM/yyyy")</small>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.ShippingAddress))
                                {
                                    <div class="small text-muted mb-3">
                                        <i class="bi bi-geo-alt"></i> @item.ShippingAddress
                                    </div>
                                }

                                <form method="post" asp-page-handler="SellItem" class="mt-auto">
                                    <input type="hidden" name="itemId" value="@item.Id" />
                                    <label class="form-label small fw-semibold">Preço para venda</label>
                                    <div class="input-group">
                                        <span class="input-group-text">€</span>
                                        <input type="number" name="salePrice" class="form-control" min="0.01" step="0.01" value="@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-tag"></i> Vender
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {


        @if (!Model.ItemsForSale.Any())
        {
            <div class="alert alert-info text-center py-5">
                <i class="bi bi-inbox fs-1"></i>
                <h4 class="mt-2">Nenhum item à venda</h4>
                <p>Troque para o perfil de comprador para vender itens da sua coleção.</p>
                <a href="/Shop/Create" class="btn btn-primary">Criar novo item para venda</a>
            </div>
        }
        else
        {
            <div class="row g-4 mb-5">
                @foreach (var item in Model.ItemsForSale)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="item-image">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" />
                                }
                                else
                                {
                                    <div class="image-placeholder"><i class="bi bi-box-seam"></i></div>
                                }
                                <span class="item-badge badge bg-primary">À Venda</span>
                            </div>
                            <div class="card-body">
                                <h5 class="card-title">@item.Name</h5>
                                <p class="card-text text-muted">@item.Description</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-primary">@item.Price.ToString("C")</span>
                                    <span class="badge @(item.Status == "Disponível" ? "bg-success" : "bg-secondary")">@item.Status</span>
                                </div>
                                <small class="text-muted d-block mt-2">
                                    <i class="bi bi-clock"></i> Submetido em @item.SubmittedAt.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <h3 class="mb-3">
        <i class="bi bi-receipt"></i>
        @(Model.IsBuyerProfile ? "Histórico de compras" : "Histórico de vendas")
    </h3>

    @if (!Model.Transactions.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-inbox fs-1"></i>
            <h4 class="mt-2">Nenhuma transação</h4>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Data</th>
                        <th>Item</th>
                        <th>@(Model.IsBuyerProfile ? "Vendedor" : "Comprador")</th>
                        <th>Preço</th>
                        <th>Status</th>
                        <th>Endereço</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Transactions)
                    {
                        <tr>
                            <td>@t.Date.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@t.ItemName</td>
                            <td>@t.OtherPartyName</td>
                            <td class="fw-bold">@t.Price.ToString("C")</td>
                            <td><span class="badge @GetStatusBadgeClass(t.Status)">@t.Status</span></td>
                            <td>@t.ShippingAddress</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <style>
        .item-image {
            position: relative;
            height: 180px;
            background: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 12px 12px 0 0;
        }

            .item-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .image-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            color: #dee2e6;
        }

            .image-placeholder i {
                font-size: 4rem;
            }

        .item-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
        }
    </style>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pago" or "Concluída" or "Entregue" => "bg-success",
            "Pendente" => "bg-warning",
            "Enviado" => "bg-info",
            "Cancelado" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
