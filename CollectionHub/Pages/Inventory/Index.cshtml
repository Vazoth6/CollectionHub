@page "/Inventory"
@model CollectionHub.Pages.Inventory.IndexModel
@{
    ViewData["Title"] = "Meu Inventário";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="display-5 mb-2">
                <i class="bi bi-box-seam text-success"></i> Meu Inventário
            </h1>
            <p class="text-muted">Gerencie os seus itens comprados e à venda</p>
            <hr />
        </div>
    </div>

    <!-- Saldo da Carteira -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-info bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Saldo Disponível</h6>
                            <h2 class="mb-0 text-success">@Model.WalletBalance.ToString("C")</h2>
                        </div>
                        <i class="bi bi-wallet2 fs-1 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-primary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Itens à Venda</h6>
                            <h2 class="mb-0 text-primary">@Model.ItemsForSale.Count</h2>
                        </div>
                        <i class="bi bi-tag fs-1 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-success bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Itens Comprados</h6>
                            <h2 class="mb-0 text-success">@Model.ItemsPurchased.Count</h2>
                        </div>
                        <i class="bi bi-check-circle fs-1 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" id="inventoryTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="purchased-tab" data-bs-toggle="tab"
                    data-bs-target="#purchased" type="button" role="tab">
                <i class="bi bi-bag-check"></i> Itens Comprados
                <span class="badge bg-secondary ms-2">@Model.ItemsPurchased.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="forsale-tab" data-bs-toggle="tab"
                    data-bs-target="#forsale" type="button" role="tab">
                <i class="bi bi-tag"></i> Itens à Venda
                <span class="badge bg-secondary ms-2">@Model.ItemsForSale.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="transactions-tab" data-bs-toggle="tab"
                    data-bs-target="#transactions" type="button" role="tab">
                <i class="bi bi-receipt"></i> Transações
                <span class="badge bg-secondary ms-2">@Model.Transactions.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="inventoryTabContent">
        <!-- Itens Comprados -->
        <div class="tab-pane fade show active" id="purchased" role="tabpanel">
            @if (!Model.ItemsPurchased.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-inbox fs-1"></i>
                    <h4 class="mt-2">Nenhum item comprado</h4>
                    <p>Visite a <a href="/Shop">Loja</a> para comprar itens!</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model.ItemsPurchased)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="item-image">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" />
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                    }
                                    <span class="item-badge badge bg-success">Comprado</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@item.Name</h5>
                                    <p class="card-text text-muted">@item.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary">@item.Price.ToString("C")</span>
                                        <small class="text-muted">@item.PurchaseDate?.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.ShippingAddress))
                                    {
                                        <div class="mt-2 small text-muted">
                                            <i class="bi bi-geo-alt"></i> @item.ShippingAddress
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Itens à Venda -->
        <div class="tab-pane fade" id="forsale" role="tabpanel">
            @if (!Model.ItemsForSale.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-inbox fs-1"></i>
                    <h4 class="mt-2">Nenhum item à venda</h4>
                    <a href="/Shop/Create" class="btn btn-primary">Vender um item</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in Model.ItemsForSale)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-sm border-0 h-100">
                                <div class="item-image">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" />
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                    }
                                    <span class="item-badge badge bg-primary">À Venda</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@item.Name</h5>
                                    <p class="card-text text-muted">@item.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary">@item.Price.ToString("C")</span>
                                        <span class="badge @(item.Status == "Disponível" ? "bg-success" : "bg-secondary")">
                                            @item.Status
                                        </span>
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        <i class="bi bi-clock"></i> Submetido em @item.SubmittedAt.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Transações -->
        <div class="tab-pane fade" id="transactions" role="tabpanel">
            @if (!Model.Transactions.Any())
            {
                <div class="alert alert-info text-center py-5">
                    <i class="bi bi-inbox fs-1"></i>
                    <h4 class="mt-2">Nenhuma transação</h4>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Data</th>
                                <th>Item</th>
                                <th>Comprador/Vendedor</th>
                                <th>Preço</th>
                                <th>Tipo</th>
                                <th>Status</th>
                                <th>Endereço</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.Transactions)
                            {
                                <tr>
                                    <td>@t.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@t.ItemName</td>
                                    <td>@t.OtherPartyName</td>
                                    <td class="fw-bold">@t.Price.ToString("C")</td>
                                    <td>
                                        <span class="badge @(t.TransactionType == "Compra" ? "bg-success" : "bg-warning")">
                                            @t.TransactionType
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(t.Status)">
                                            @t.Status
                                        </span>
                                    </td>
                                    <td>@t.ShippingAddress</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <style>
        .item-image {
            position: relative;
            height: 180px;
            background: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border-radius: 12px 12px 0 0;
        }

            .item-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .image-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            color: #dee2e6;
        }

            .image-placeholder i {
                font-size: 4rem;
            }

        .item-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.7rem;
        }
    </style>
}

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pago" or "Concluída" => "bg-success",
            "Pendente" => "bg-warning",
            "Enviado" => "bg-info",
            "Cancelado" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}