@page "/Shop/Create"
@model CollectionHub.Pages.Shop.CreateModel
@{
    ViewData["Title"] = "Vender Item - CollectionHub";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-plus-circle"></i> Vender Novo Item
                    </h3>
                </div>
                <div class="card-body p-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" enctype="multipart/form-data" id="itemForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Nome do Item -->
                        <div class="mb-3">
                            <label asp-for="CreateItem.Name" class="form-label fw-bold">
                                <i class="bi bi-tag"></i> Nome do Item
                            </label>
                            <input asp-for="CreateItem.Name" class="form-control form-control-lg"
                                   placeholder="Ex: Pikachu 1st Edition" />
                            <span asp-validation-for="CreateItem.Name" class="text-danger"></span>
                            <small class="text-muted">máx. 100 caracteres</small>
                        </div>

                        <!-- Descrição -->
                        <div class="mb-3">
                            <label asp-for="CreateItem.Description" class="form-label fw-bold">
                                <i class="bi bi-card-text"></i> Descrição
                            </label>
                            <textarea asp-for="CreateItem.Description" class="form-control" rows="5"
                                      placeholder="Descreva o seu item em detalhe..."></textarea>
                            <span asp-validation-for="CreateItem.Description" class="text-danger"></span>
                            <small class="text-muted">máx. 500 caracteres</small>
                        </div>

                        <!-- Preço e Categoria -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateItem.Price" class="form-label fw-bold">
                                    <i class="bi bi-currency-euro"></i> Preço
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">€</span>
                                    <input asp-for="CreateItem.Price" class="form-control"
                                           placeholder="0.00" step="0.01" />
                                </div>
                                <span asp-validation-for="CreateItem.Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="CreateItem.CategoryId" class="form-label fw-bold">
                                    <i class="bi bi-grid"></i> Categoria
                                </label>
                                <select asp-for="CreateItem.CategoryId" class="form-select"
                                        asp-items="Model.CategoriesSelectList">
                                    <option value="">-- Selecione uma Categoria --</option>
                                </select>
                                <span asp-validation-for="CreateItem.CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- ⭐ DROPZONE PARA IMAGEM -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="bi bi-image"></i> Imagem do Item (Opcional)
                            </label>
                            <div class="drop-zone" id="dropZone">
                                <div class="drop-zone-content">
                                    <i class="bi bi-cloud-upload fs-1 text-primary"></i>
                                    <p class="mb-1">Arraste e solte uma imagem aqui</p>
                                    <small class="text-muted">ou clique para selecionar</small>
                                    <input type="file" class="d-none" id="imageUpload"
                                           accept="image/jpeg,image/png,image/gif,image/webp"
                                           name="ImageFile" />
                                </div>
                                <div class="drop-zone-preview d-none" id="imagePreview">
                                    <img id="previewImage" src="#" alt="Preview" />
                                    <button type="button" class="btn btn-sm btn-danger mt-2" id="removeImage">
                                        <i class="bi bi-x"></i> Remover
                                    </button>
                                </div>
                            </div>
                            <small class="text-muted">Formatos: JPG, PNG, GIF, WEBP. Máx. 5MB</small>
                            <div id="imageError" class="text-danger"></div>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-success btn-lg" id="submitBtn">
                                <i class="bi bi-check-lg"></i> Publicar Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Dicas -->
            <div class="card mt-4 bg-light border-0">
                <div class="card-body">
                    <h6><i class="bi bi-lightbulb text-warning"></i> Dicas para vender mais rápido:</h6>
                    <ul class="small text-muted mb-0">
                        <li>Use um título claro e descritivo</li>
                        <li>Adicione uma descrição detalhada do produto</li>
                        <li>Selecione a categoria correta para melhor visibilidade</li>
                        <li>Adicione uma imagem de qualidade do produto</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* ⭐ DROPZONE ESTILOS */
        .drop-zone {
            border: 2px dashed #ced4da;
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fafafa;
        }

            .drop-zone:hover {
                border-color: #667eea;
                background: #f8f9ff;
            }

            .drop-zone.dragover {
                border-color: #667eea;
                background: #eef1ff;
                transform: scale(1.01);
            }

        .drop-zone-content {
            pointer-events: none;
        }

            .drop-zone-content i {
                display: block;
                margin-bottom: 0.5rem;
            }

            .drop-zone-content p {
                margin-bottom: 0.25rem;
                font-weight: 500;
            }

        .drop-zone-preview {
            position: relative;
            width: 100%;
            max-width: 300px;
            margin: 0 auto;
        }

            .drop-zone-preview img {
                max-width: 100%;
                max-height: 250px;
                border-radius: 8px;
                object-fit: contain;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }

            .drop-zone-preview .btn-remove-image {
                position: absolute;
                top: -10px;
                right: -10px;
                border-radius: 50%;
                width: 32px;
                height: 32px;
                padding: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #dc3545;
                border: none;
                color: white;
                font-size: 1rem;
                box-shadow: 0 2px 8px rgba(220, 53, 69, 0.3);
                transition: all 0.2s ease;
            }

                .drop-zone-preview .btn-remove-image:hover {
                    transform: scale(1.1);
                    background: #c82333;
                }

        #imageError {
            margin-top: 0.5rem;
            font-size: 0.875rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            const dropZone = document.getElementById('dropZone');
            const fileInput = document.getElementById('imageUpload');
            const previewContainer = document.getElementById('imagePreview');
            const previewImage = document.getElementById('previewImage');
            const removeBtn = document.getElementById('removeImage');
            const imageError = document.getElementById('imageError');
            const form = document.getElementById('itemForm');

            // ⭐ CLICK PARA ABRIR SELETOR
            dropZone.addEventListener('click', () => fileInput.click());

            // ⭐ DRAG AND DROP
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });

            dropZone.addEventListener('dragleave', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            });

            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                if (e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    handleFile(e.dataTransfer.files[0]);
                }
            });

            // ⭐ SELEÇÃO DE FICHEIRO
            fileInput.addEventListener('change', function() {
                if (this.files.length) {
                    handleFile(this.files[0]);
                }
            });

            // ⭐ PROCESSAR FICHEIRO
            function handleFile(file) {
                imageError.textContent = '';

                // Validar tamanho (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    imageError.textContent = 'A imagem é muito grande. Máximo 5MB.';
                    fileInput.value = '';
                    return;
                }

                // Validar tipo
                const validTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
                if (!validTypes.includes(file.type)) {
                    imageError.textContent = 'Formato de imagem não suportado. Use JPG, PNG, GIF ou WEBP.';
                    fileInput.value = '';
                    return;
                }

                // Preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    document.querySelector('.drop-zone-content').classList.add('d-none');
                    previewContainer.classList.remove('d-none');
                    dropZone.style.borderColor = '#28a745';
                    dropZone.style.background = '#f0fff4';
                    imageError.textContent = '';
                };
                reader.readAsDataURL(file);
            }

            // ⭐ REMOVER IMAGEM
            removeBtn.addEventListener('click', function() {
                fileInput.value = '';
                previewContainer.classList.add('d-none');
                document.querySelector('.drop-zone-content').classList.remove('d-none');
                dropZone.style.borderColor = '#ced4da';
                dropZone.style.background = '#fafafa';
                imageError.textContent = '';
            });

            // ⭐ VALIDAR ANTES DE SUBMETER
            form.addEventListener('submit', function(e) {
                if (imageError.textContent !== '') {
                    e.preventDefault();
                    alert('Corrija o erro da imagem antes de submeter.');
                    return false;
                }
                return true;
            });

            // ⭐ VALIDAÇÃO DE PREÇO
            document.querySelector('input[name="CreateItem.Price"]')?.addEventListener('input', function() {
                let value = parseFloat(this.value);
                if (value < 0) this.value = 0;
                if (value > 999999.99) this.value = 999999.99;
            });
        })();
    </script>
}