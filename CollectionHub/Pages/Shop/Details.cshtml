@page "/Shop/Details/{id:int}"
@model CollectionHub.Pages.Shop.DetailsModel
@{
    ViewData["Title"] = Model.Item?.Name ?? "Detalhes do Coleccionável";
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Item != null)
    {
        <div class="row g-4">
            <div class="col-md-5">
                <div class="card shadow-sm border-0">
                    <div class="item-image-container">
                        @if (!string.IsNullOrEmpty(Model.Item.ImageUrl))
                        {
                            <img src="@Model.Item.ImageUrl" alt="@Model.Item.Name" class="img-fluid rounded-3">
                        }
                        else
                        {
                            <div class="image-placeholder-large">
                                <i class="bi bi-box-seam"></i>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <span class="badge bg-primary">@Model.Item.CategoryName</span>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form method="post" asp-page-handler="ToggleLike">
                                    <input type="hidden" name="itemId" value="@Model.Item.Id" />
                                    <button type="submit" class="btn @(Model.IsLikedByCurrentUser ? "btn-danger" : "btn-outline-danger")">
                                        <i class="bi @(Model.IsLikedByCurrentUser ? "bi-heart-fill" : "bi-heart")"></i>
                                        @Model.LikeCount
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-danger">
                                    <i class="bi bi-heart"></i>
                                    @Model.LikeCount
                                </a>
                            }
                        </div>

                        <h1 class="display-6 fw-bold mb-3">@Model.Item.Name</h1>

                        <div class="mb-3">
                            <div class="item-price-large">
                                <span class="price-symbol">€</span>
                                <span class="price-value">@Model.Item.Price.ToString("F2")</span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h5><i class="bi bi-info-circle"></i> Descrição</h5>
                            <p class="text-muted">@Model.Item.Description</p>
                        </div>

                        <div class="mb-4">
                            <div class="row g-3">
                                <div class="col-6">
                                    <div class="d-flex align-items-center gap-2 text-muted">
                                        <i class="bi bi-person-circle fs-5"></i>
                                        <div>
                                            <small class="d-block">Vendedor</small>
                                            <strong>@Model.Item.SellerName</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-6">
                                    <div class="d-flex align-items-center gap-2 text-muted">
                                        <i class="bi bi-calendar3 fs-5"></i>
                                        <div>
                                            <small class="d-block">Data de submissão</small>
                                            <strong>@(Model.SubmittedAt?.ToString("dd/MM/yyyy") ?? "N/A")</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <span class="badge @(Model.Item.Status == "Disponível" ? "bg-primary" : "bg-secondary") fs-6 px-3 py-2">
                                <i class="bi bi-circle-fill me-1"></i> @Model.Item.Status
                            </span>
                        </div>

                        <hr />

                        <div class="d-flex gap-3">
                            @if (Model.Item.Status == "Disponível")
                            {
                                <form method="post" asp-page-handler="AddToCart" class="flex-grow-1">
                                    <input type="hidden" name="itemId" value="@Model.Item.Id" />
                                    <button type="submit" class="btn btn-success btn-lg w-100">
                                        <i class="bi bi-cart-plus"></i> Adicionar ao Carrinho
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-lg flex-grow-1" disabled>
                                    <i class="bi bi-x-circle"></i> Item Indisponível
                                </button>
                            }

                            <a href="/Shop" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Voltar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger text-center py-5">
            <i class="bi bi-exclamation-triangle fs-1"></i>
            <h4 class="mt-2">Item não encontrado</h4>
            <p>O item que procura não existe ou foi removido.</p>
            <a href="/Shop" class="btn btn-primary">Voltar à Loja</a>
        </div>
    }
</div>

@section Styles {
    <style>
        .item-image-container {
            background: #f8f9fa;
            border-radius: 16px;
            padding: 2rem;
            text-align: center;
            min-height: 400px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .item-image-container img {
            max-height: 350px;
            object-fit: contain;
        }

        .image-placeholder-large {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            min-height: 300px;
        }

        .image-placeholder-large i {
            font-size: 8rem;
            color: #dee2e6;
        }

        .item-price-large {
            display: inline-flex;
            align-items: baseline;
            gap: 4px;
        }

        .item-price-large .price-symbol {
            font-size: 1.8rem;
            font-weight: 400;
            color: #000000;
            vertical-align: baseline;
        }

        .item-price-large .price-value {
            font-size: 3rem;
            font-weight: 400;
            color: #000000;
            line-height: 1;
        }
    </style>
}