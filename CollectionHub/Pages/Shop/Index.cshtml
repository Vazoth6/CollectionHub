@section Scripts {
    <script>
        function openBuyModal(id, name, price) {
            document.getElementById('itemId').value = id;
            document.getElementById('itemName').innerText = name;
            document.getElementById('itemPrice').innerHTML = new Intl.NumberFormat('pt-PT', {
                style: 'currency',
                currency: 'EUR'
            }).format(price);
            new bootstrap.Modal(document.getElementById('buyModal')).show();
        }

        function submitFilterForm() {
            const form = document.getElementById('filterForm');
            const searchValue = document.getElementById('SearchTermHeader').value;

            let searchInput = form.querySelector('input[name="SearchTerm"]');
            if (!searchInput) {
                searchInput = document.createElement('input');
                searchInput.type = 'hidden';
                searchInput.name = 'SearchTerm';
                form.appendChild(searchInput);
            }

            searchInput.value = searchValue;
            form.submit();
        }

        (function () {
            const sliderMin = document.getElementById('priceSliderMin');
            const sliderMax = document.getElementById('priceSliderMax');
            const inputMin = document.getElementById('MinPrice');
            const inputMax = document.getElementById('MaxPrice');
            const displayMin = document.getElementById('sliderMinDisplay');
            const displayMax = document.getElementById('sliderMaxDisplay');
            const hintMin = document.getElementById('sliderMinHint');
            const hintMax = document.getElementById('sliderMaxHint');
            const trackFill = document.getElementById('trackFill');
            const minVal = 0;
            const maxVal = 5000;

            if (!sliderMin || !sliderMax || !inputMin || !inputMax) return;

            function updateTrack() {
                const min = parseInt(sliderMin.value);
                const max = parseInt(sliderMax.value);
                const total = maxVal - minVal;

                const minPercent = ((min - minVal) / total) * 100;
                const maxPercent = ((max - minVal) / total) * 100;

                if (trackFill) {
                    trackFill.style.left = minPercent + '%';
                    trackFill.style.width = (maxPercent - minPercent) + '%';
                }
            }

            function updateDisplay() {
                const min = parseInt(sliderMin.value);
                const max = parseInt(sliderMax.value);

                displayMin.textContent = min + '€';
                displayMax.textContent = max + '€';

                if (hintMin) hintMin.textContent = min.toFixed(2);
                if (hintMax) hintMax.textContent = max.toFixed(2);

                inputMin.value = min;
                inputMax.value = max;

                updateTrack();
            }

            function roundToStep(value) {
                return Math.round(value / 10) * 10;
            }

            function initialize() {
                let min = parseInt(sliderMin.value);
                let max = parseInt(sliderMax.value);

                min = roundToStep(min);
                max = roundToStep(max);

                if (min < 0) min = 0;
                if (max > 5000) max = 5000;
                if (min > max) min = max - 10;
                if (min < 0) min = 0;

                sliderMin.value = min;
                sliderMax.value = max;

                updateDisplay();
            }

            sliderMin.addEventListener('input', function () {
                let min = parseInt(this.value);
                let max = parseInt(sliderMax.value);

                if (min > max - 10) {
                    min = max - 10;
                    this.value = min;
                }

                updateDisplay();
            });

            sliderMax.addEventListener('input', function () {
                let min = parseInt(sliderMin.value);
                let max = parseInt(this.value);

                if (max < min + 10) {
                    max = min + 10;
                    this.value = max;
                }

                updateDisplay();
            });

            inputMin.addEventListener('change', function () {
                let value = parseFloat(this.value);

                if (value < 0) value = 0;
                if (value > 5000) value = 5000;

                value = roundToStep(value);

                if (value > parseInt(sliderMax.value) - 10) {
                    value = parseInt(sliderMax.value) - 10;
                }

                if (value < 0) value = 0;

                sliderMin.value = value;
                updateDisplay();
            });

            inputMax.addEventListener('change', function () {
                let value = parseFloat(this.value);

                if (value < 0) value = 0;
                if (value > 5000) value = 5000;

                value = roundToStep(value);

                if (value < parseInt(sliderMin.value) + 10) {
                    value = parseInt(sliderMin.value) + 10;
                }

                if (value > 5000) value = 5000;

                sliderMax.value = value;
                updateDisplay();
            });

            initialize();
        })();

        document.getElementById('searchButton')?.addEventListener('click', function () {
            submitFilterForm();
        });

        document.getElementById('SearchTermHeader')?.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                submitFilterForm();
            }
        });
    </script>
}

@functions {
    public string GetPageUrl(int page)
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(Model.SearchTerm)) query.Add($"SearchTerm={Uri.EscapeDataString(Model.SearchTerm)}");
        if (Model.CategoryId.HasValue && Model.CategoryId.Value > 0) query.Add($"CategoryId={Model.CategoryId}");
        if (Model.MinPrice.HasValue) query.Add($"MinPrice={Model.MinPrice}");
        if (Model.MaxPrice.HasValue) query.Add($"MaxPrice={Model.MaxPrice}");
        if (!string.IsNullOrEmpty(Model.SortBy)) query.Add($"SortBy={Model.SortBy}");
        if (Model.SelectedCategories != null && Model.SelectedCategories.Any())
        {
            foreach (var cat in Model.SelectedCategories)
            {
                query.Add($"SelectedCategories={Uri.EscapeDataString(cat)}");
            }
        }
        query.Add($"CurrentPage={page}");

        return $"/Shop?{string.Join("&", query)}";
    }
}