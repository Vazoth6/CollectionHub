@page "/Shop"
@model CollectionHub.Pages.Shop.IndexModel
@{
    ViewData["Title"] = "Marketplace - CollectionHub";

    var hasSelectedCategories = Model.SelectedCategories != null && Model.SelectedCategories.Any();
    var hasSearchFilter = !string.IsNullOrWhiteSpace(Model.SearchTerm);
    var hasMinPriceFilter = Model.MinPrice.HasValue && Model.MinPrice.Value > 0;
    var hasMaxPriceFilter = Model.MaxPrice.HasValue && Model.MaxPrice.Value < 5000;
    var hasPriceFilter = hasMinPriceFilter || hasMaxPriceFilter;
    var hasSortFilter = !string.IsNullOrWhiteSpace(Model.SortBy) && Model.SortBy != "name_asc";
    var hasAnyActiveFilter = hasSelectedCategories || hasSearchFilter || hasPriceFilter || hasSortFilter;
}

<div class="container-fluid px-4">
    <div class="hero-section text-center py-5 mb-4">
        <div class="container">
            <h1 class="display-4 fw-bold text-white mb-3">Loja</h1>
            <p class="lead text-white-50 mb-4">Descubra videojogos, cartas, moedas e muito mais de vendedores verificados</p>
            @* ⭐ ALTERAR: Qualquer utilizador autenticado pode vender *@
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-page="Create" class="btn btn-light btn-lg px-5">
                    <i class="bi bi-plus-circle"></i> Vender Coleccionável
                </a>
            }
        </div>
    </div>

    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="filters-card @(hasAnyActiveFilter ? "filters-card-active" : "")">
                    <div class="filters-header">
                        <i class="bi bi-funnel"></i>
                        <h5 class="mb-0">Filtros</h5>
                        @if (hasAnyActiveFilter)
                        {
                            <span class="active-filters-pill">Ativos</span>
                        }
                    </div>

                    <form method="get" id="filterForm">
                        <input type="hidden" name="SearchTerm" id="SearchTermHidden" value="@Model.SearchTerm" />

                        <div class="filter-section @(hasSelectedCategories ? "filter-section-active" : "")">
                            <label class="filter-label">Categorias</label>
                            <div class="categories-list">
                                @foreach (var cat in Model.PredefinedCategories)
                                {
                                    var isCategorySelected = Model.SelectedCategories != null && Model.SelectedCategories.Contains(cat.Name);

                                    <div class="form-check category-filter-option @(isCategorySelected ? "filter-option-selected" : "")">
                                        <input type="checkbox" class="form-check-input"
                                               name="SelectedCategories"
                                               id="cat_@cat.Name.Replace(" ", "_")"
                                               value="@cat.Name"
                                               checked="@isCategorySelected">
                                        <label class="form-check-label" for="cat_@cat.Name.Replace(" ", "_")">
                                            @cat.Name
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="filter-section @(hasPriceFilter ? "filter-section-active" : "")">
                            <label class="filter-label">Faixa de Preço</label>

                            <div class="price-slider-container">
                                <div class="price-slider-wrapper">
                                    <div class="price-slider-track">
                                        <div class="price-slider-track-fill" id="trackFill"></div>
                                    </div>
                                    <input type="range" class="price-slider price-slider-min" id="priceSliderMin"
                                           min="0" max="5000" step="10"
                                           value="@(Model.MinPrice.HasValue ? (int)Math.Round(Model.MinPrice.Value / 10) * 10 : 0)" />
                                    <input type="range" class="price-slider price-slider-max" id="priceSliderMax"
                                           min="0" max="5000" step="10"
                                           value="@(Model.MaxPrice.HasValue ? (int)Math.Round(Model.MaxPrice.Value / 10) * 10 : 5000)" />
                                </div>

                                <div class="price-slider-labels">
                                    <span id="sliderMinDisplay">@(Model.MinPrice.HasValue ? ((int)Math.Round(Model.MinPrice.Value / 10) * 10).ToString("F0") : "0")€</span>
                                    <span id="sliderMaxDisplay">@(Model.MaxPrice.HasValue ? ((int)Math.Round(Model.MaxPrice.Value / 10) * 10).ToString("F0") : "5000")€</span>
                                </div>
                            </div>

                            <div class="row g-2 mt-2">
                                <div class="col-6">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">€</span>
                                        <input type="number" class="form-control" name="MinPrice"
                                               id="MinPrice" placeholder="0.25"
                                               value="@(Model.MinPrice ?? 0.25m)"
                                               step="0.01" min="0" max="5000" />
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">€</span>
                                        <input type="number" class="form-control" name="MaxPrice"
                                               id="MaxPrice" placeholder="5000"
                                               value="@(Model.MaxPrice ?? 5000m)"
                                               step="0.5" min="0" max="5000" />
                                    </div>
                                </div>
                            </div>
                            <div class="price-range-hint">
                                <small><span id="sliderMinHint">@(Model.MinPrice?.ToString("F2") ?? "0.00")</span>€ - <span id="sliderMaxHint">@(Model.MaxPrice?.ToString("F2") ?? "5000.00")</span>€</small>
                            </div>
                        </div>

                        <div class="filter-section @(hasSortFilter ? "filter-section-active" : "")">
                            <label class="filter-label">Ordenar por</label>
                            <select class="form-select form-select-sm" name="SortBy" id="SortBy">
                                <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Nome (A-Z)</option>
                                <option value="name_desc" selected="@(Model.SortBy == "name_desc")">Nome (Z-A)</option>
                                <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Preço (menor para maior)</option>
                                <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Preço (maior para menor)</option>
                            </select>
                        </div>

                        <div class="filter-actions">
                            <button type="submit" class="btn btn-primary w-100 mb-2">
                                <i class="bi bi-search"></i> Aplicar Filtros
                            </button>
                            <a href="/Shop" class="btn btn-outline-secondary w-100">
                                <i class="bi bi-arrow-repeat"></i> Limpar Filtros
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="col-lg-9">
                <div class="search-bar-wrapper mb-4">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-primary"></i>
                        </span>
                        <input type="text" class="form-control border-start-0"
                               name="SearchTerm" id="SearchTermHeader"
                               placeholder="Pesquisar coleccionáveis por nome, descrição..."
                               value="@Model.SearchTerm" />
                        <button class="btn btn-primary" type="button" id="searchButton">
                            <i class="bi bi-search"></i> Pesquisar
                        </button>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="mb-0">Coleccionáveis Disponíveis</h4>
                        <p class="text-muted small mb-0">
                            <i class="bi bi-grid"></i> @Model.Items.Count() de @Model.TotalItems coleccionáveis encontrados
                        </p>
                    </div>
                    <div class="d-none d-md-block">
                        <span class="text-muted me-2">Visualização:</span>
                        <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>
                        <i class="bi bi-list-ul text-muted"></i>
                    </div>
                </div>

                <div class="row g-4" id="itemsGrid">
                    @if (Model.Items.Any())
                    {
                        @foreach (var item in Model.Items)
                        {
                            <div class="col-md-6 col-xl-4">
                                <a href="/Shop/Details/@item.Id" class="text-decoration-none">
                                    <div class="item-card">
                                        <div class="item-image">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid">
                                            }
                                            else
                                            {
                                                <div class="image-placeholder">
                                                    <i class="bi bi-box-seam"></i>
                                                </div>
                                            }
                                            <span class="item-category">@item.CategoryName</span>
                                        </div>
                                        <div class="item-body">
                                            <h5 class="item-title">@item.Name</h5>
                                            <p class="item-description">
                                                @(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                                            </p>
                                            <div class="item-price">
                                                @item.Price.ToString("C")
                                            </div>
                                            <div class="item-footer">
                                                <div class="seller-info">
                                                    <i class="bi bi-person-circle"></i>
                                                    <span>@item.SellerName</span>
                                                </div>
                                                <div class="btn-buy-placeholder">
                                                    <i class="bi bi-arrow-right-circle"></i> Ver Detalhes
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <h4>Nenhum coleccionável encontrado</h4>
                                <p>Tente ajustar os filtros ou</p>
                                @if (User.IsInRole("Vendedor") || User.IsInRole("Admin"))
                                {
                                    <a asp-page="Create" class="btn btn-primary">Vender um coleccionável</a>
                                }
                                else
                                {
                                    <span>volte mais tarde!</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-5">
                        <ul class="pagination justify-content-center">
                            @if (Model.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@GetPageUrl(Model.CurrentPage - 1)">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            @{
                                int startPage = Math.Max(1, Model.CurrentPage - 2);
                                int endPage = Math.Min(Model.TotalPages, startPage + 4);
                                if (endPage - startPage < 4 && startPage > 1)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item"><a class="page-link" href="@GetPageUrl(1)">1</a></li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@GetPageUrl(i)">@i</a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                                <li class="page-item"><a class="page-link" href="@GetPageUrl(Model.TotalPages)">@Model.TotalPages</a></li>
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@GetPageUrl(Model.CurrentPage + 1)">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="buyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title">
                    <i class="bi bi-cart-check text-success"></i> Confirmar Compra
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Buy">
                <div class="modal-body pt-0">
                    <input type="hidden" id="itemId" name="itemId" />
                    <div class="text-center py-3">
                        <div class="bg-light rounded-circle d-inline-flex p-3 mb-3">
                            <i class="bi bi-gift fs-1 text-primary"></i>
                        </div>
                        <h6>Tem a certeza que deseja comprar</h6>
                        <p class="fw-bold fs-5 text-primary" id="itemName"></p>
                        <div class="alert alert-info">
                            <strong>Preço total:</strong>
                            <span id="itemPrice" class="fs-5 fw-bold"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="shippingAddress" class="form-label fw-bold">
                            <i class="bi bi-geo-alt"></i> Endereço de Entrega
                        </label>
                        <textarea class="form-control" id="shippingAddress" name="shippingAddress"
                                  rows="3" placeholder="Rua, Número, Cidade, Código Postal" required></textarea>
                        <small class="text-muted">Forneça um endereço completo para a entrega</small>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Confirmar Compra
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, orange 100%);
            border-radius: 0 0 30px 30px;
            margin-top: -1.5rem;
            margin-bottom: 2rem;
        }

        .filters-card {
            background: white;
            border-radius: 16px;
            padding: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            position: sticky;
            top: 20px;
            border: 1px solid transparent;
        }

        .filters-card-active {
            border-color: rgba(102, 126, 234, 0.45);
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.18);
        }

        .active-filters-pill {
            margin-left: auto;
            padding: 4px 10px;
            border-radius: 999px;
            background: rgba(102, 126, 234, 0.12);
            color: #667eea;
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .filters-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid #eef2f6;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .filters-header i {
                font-size: 1.25rem;
                color: #667eea;
            }

            .filters-header h5 {
                font-weight: 600;
            }

        .filter-section {
            padding: 0.75rem 1.25rem;
            border-bottom: 1px solid #eef2f6;
            transition: background-color 0.2s ease, border-left-color 0.2s ease;
            border-left: 4px solid transparent;
        }

        .filter-section-active {
            background: rgba(102, 126, 234, 0.07);
            border-left-color: #667eea;
        }

            .filter-section-active .filter-label {
                color: #667eea;
            }

        .filter-label {
            font-size: 0.78rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #6c757d;
            margin-bottom: 0.5rem;
            display: block;
        }

        .categories-list {
            max-height: none;
            overflow: visible;
        }

            .categories-list .form-check {
                padding-left: 0;
                margin-bottom: 0;
            }

        .category-filter-option {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px;
            border-radius: 8px;
            transition: background-color 0.2s ease, box-shadow 0.2s ease;
        }

            .category-filter-option:hover {
                background: #f8f9fa;
            }

        .categories-list .form-check-input {
            margin: 0;
            cursor: pointer;
            width: 0.95rem;
            height: 0.95rem;
        }

        .categories-list .form-check-label {
            cursor: pointer;
            font-size: 0.82rem;
            color: #495057;
            flex: 1;
            line-height: 1.15;
        }

        .filter-option-selected {
            background: rgba(102, 126, 234, 0.12);
            box-shadow: inset 0 0 0 1px rgba(102, 126, 234, 0.25);
        }

            .filter-option-selected .form-check-label {
                color: #4f5fd5;
                font-weight: 700;
            }

        .price-range-hint {
            margin-top: 5px;
            color: #6c757d;
            font-size: 0.7rem;
        }

        .price-slider-container {
            padding: 12px 0 4px 0;
            position: relative;
        }

        .price-slider-wrapper {
            position: relative;
            height: 32px;
            display: flex;
            align-items: center;
        }

        .price-slider-track {
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 6px;
            background: #e9ecef;
            border-radius: 4px;
            transform: translateY(-50%);
            z-index: 1;
            overflow: hidden;
        }

        .price-slider-track-fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            background: linear-gradient(90deg, orange);
            border-radius: 4px;
            z-index: 2;
            pointer-events: none;
            width: 100%;
        }

        .price-slider {
            position: absolute;
            width: 100%;
            height: 6px;
            -webkit-appearance: none;
            appearance: none;
            background: transparent;
            pointer-events: none;
            z-index: 3;
            margin: 0;
            padding: 0;
            top: 50%;
            transform: translateY(-50%);
        }

            .price-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 22px;
                height: 22px;
                border-radius: 50%;
                background: linear-gradient(135deg, orange 100%);
                cursor: pointer;
                pointer-events: auto;
                border: 3px solid white;
                box-shadow: 0 2px 10px rgba(102, 126, 234, 0.4);
                transition: all 0.2s ease;
                z-index: 4;
                position: relative;
            }

                .price-slider::-webkit-slider-thumb:hover {
                    transform: scale(1.15);
                    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.6);
                }

                .price-slider::-webkit-slider-thumb:active {
                    transform: scale(0.95);
                }

            .price-slider::-moz-range-thumb {
                width: 22px;
                height: 22px;
                border-radius: 50%;
                background: linear-gradient(135deg, orange 100%);
                cursor: pointer;
                pointer-events: auto;
                border: 3px solid white;
                box-shadow: 0 2px 10px rgba(102, 126, 234, 0.4);
            }

            .price-slider::-webkit-slider-runnable-track {
                height: 6px;
                background: transparent;
                pointer-events: none;
            }

            .price-slider::-moz-range-track {
                height: 6px;
                background: transparent;
                pointer-events: none;
            }

        .price-slider-min {
            z-index: 4;
        }

        .price-slider-max {
            z-index: 5;
        }

        .price-slider-labels {
            display: flex;
            justify-content: space-between;
            margin-top: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #495057;
        }

            .price-slider-labels span {
                background: #f8f9fa;
                padding: 4px 12px;
                border-radius: 20px;
                border: 1px solid #e9ecef;
                font-size: 0.8rem;
                min-width: 58px;
                text-align: center;
            }

                .price-slider-labels span:first-child {
                    color: #667eea;
                }

                .price-slider-labels span:last-child {
                    color: orange;
                }

        .filter-actions {
            padding: 1rem 1.25rem;
        }

        .search-bar-wrapper {
            background: white;
            border-radius: 50px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }

            .search-bar-wrapper .input-group-text {
                border-radius: 50px 0 0 50px;
                border-right: none;
            }

            .search-bar-wrapper .form-control {
                border-left: none;
                border-right: none;
            }

                .search-bar-wrapper .form-control:focus {
                    box-shadow: none;
                    border-color: #ced4da;
                }

            .search-bar-wrapper .btn {
                border-radius: 0 50px 50px 0;
                padding: 0.75rem 1.5rem;
            }

        .item-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            height: 100%;
            display: flex;
            flex-direction: column;
            cursor: pointer;
        }

            .item-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 24px rgba(0,0,0,0.12);
            }

        .item-image {
            position: relative;
            height: 180px;
            background: #f8f9fa;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .item-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .image-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

            .image-placeholder i {
                font-size: 4rem;
                color: #dee2e6;
            }

        .item-category {
            position: absolute;
            top: 12px;
            left: 12px;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
            color: white;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 500;
        }

        .item-body {
            padding: 1rem;
            flex: 1;
        }

        .item-title {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .item-description {
            font-size: 0.8rem;
            color: #6c757d;
            margin-bottom: 1rem;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.4;
        }

        .item-price {
            font-size: 1.25rem;
            font-weight: 700;
            color: #28a745;
            margin-bottom: 1rem;
        }

        .item-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 0.75rem;
            border-top: 1px solid #eef2f6;
        }

        .seller-info {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.75rem;
            color: #6c757d;
        }

            .seller-info i {
                font-size: 0.9rem;
            }

        .btn-buy-placeholder {
            background: rgba(102, 126, 234, 0.1);
            border: 1px solid #667eea;
            color: #667eea;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-buy {
            background: linear-gradient(135deg, #667eea 0%, orange 100%);
            border: none;
            color: white;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 500;
            transition: all 0.2s ease;
            text-decoration: none;
        }

            .btn-buy:hover {
                transform: scale(1.02);
                color: white;
            }

        .btn-buy-outline {
            background: transparent;
