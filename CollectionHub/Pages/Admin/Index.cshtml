@* Página Razor da área administrativa, usada para consultar ou gerir dados da aplicação. *@
@page "/Admin"
@model CollectionHub.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Painel de Administrador";
    Layout = "_Layout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="display-5 mb-2">
                <i class="bi bi-shield-lock text-primary"></i> Painel de Administrador
            </h1>
            <p class="text-muted">Bem-vindo, @User.Identity?.Name!</p>
            <hr />
        </div>
    </div>

    <!-- Estatísticas -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Utilizadores</h6>
                            <h2 class="mb-0">@Model.TotalUsers</h2>
                        </div>
                        <i class="bi bi-people fs-1 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Itens Totais</h6>
                            <h2 class="mb-0">@Model.TotalItems</h2>
                        </div>
                        <i class="bi bi-box-seam fs-1 text-success"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Transações</h6>
                            <h2 class="mb-0">@Model.TotalTransactions</h2>
                        </div>
                        <i class="bi bi-receipt fs-1 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-danger bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted mb-1">Vendas (€)</h6>
                            <h2 class="mb-0">@Model.TotalRevenue.ToString("C")</h2>
                        </div>
                        <i class="bi bi-currency-euro fs-1 text-danger"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ações Rápidas -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-people fs-1 text-primary mb-3"></i>
                    <h5>Gestão de Utilizadores</h5>
                    <p class="text-muted">Gerir todos os utilizadores da plataforma</p>
                    <a href="/Admin/Users" class="btn btn-primary">
                        <i class="bi bi-arrow-right"></i> Aceder
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-box-seam fs-1 text-success mb-3"></i>
                    <h5>Gestão de Itens</h5>
                    <p class="text-muted">Gerir todos os itens da loja</p>
                    <a href="/Admin/Items" class="btn btn-success">
                        <i class="bi bi-arrow-right"></i> Aceder
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-receipt fs-1 text-warning mb-3"></i>
                    <h5>Transações</h5>
                    <p class="text-muted">Ver todas as transações da plataforma</p>
                    <a href="/Admin/Transactions" class="btn btn-warning">
                        <i class="bi bi-arrow-right"></i> Aceder
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Atividade Recente -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent">
                    <h5 class="mb-0"><i class="bi bi-clock-history"></i> Atividade Recente</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var activity in Model.RecentActivities)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi @activity.Icon me-2"></i>
                                        <span>@activity.Description</span>
                                    </div>
                                    <small class="text-muted">@activity.Date.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-3">Nenhuma atividade recente.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Confirmação de emails -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-envelope-check text-warning"></i>
                        Confirmações de Email Pendentes
                    </h5>
                    <span class="badge bg-warning text-dark">@Model.PendingEmailConfirmations.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.PendingEmailConfirmations.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Utilizador</th>
                                        <th>Email</th>
                                        <th>Data de Registo</th>
                                        <th>Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in Model.PendingEmailConfirmations)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="bi bi-person-circle text-primary"></i>
                                                    <span>@user.Name</span>
                                                </div>
                                            </td>
                                            <td>@user.Email</td>
                                            <td>@user.RegisterDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <form method="post" asp-page-handler="ConfirmEmail" class="d-inline">
                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="bi bi-check-circle"></i> Confirmar
                                                    </button>
                                                </form>
                                                <button class="btn btn-outline-danger btn-sm" onclick="resendConfirmation('@user.UserId', '@user.Email')">
                                                    <i class="bi bi-envelope"></i> Reenviar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-check-circle text-success fs-1"></i>
                            <p class="mt-2 text-muted">Não há confirmações de email pendentes.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</div>