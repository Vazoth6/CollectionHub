@using CollectionHub.Models
@using CollectionHub.Services
@inject ICartService CartService

@{
    var cart = CartService.GetCart();
}

<div class="cart-dropdown">
    <a class="nav-link cart-icon-link" href="#" id="cartDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="bi bi-cart3"></i>
        <span class="cart-icon-count">@cart.TotalItems</span>
    </a>

    <ul class="dropdown-menu dropdown-menu-end cart-dropdown-menu" aria-labelledby="cartDropdown">
        @if (cart.Items.Any())
        {
            <li class="dropdown-header px-3 py-2">
                <strong>Meu Carrinho</strong>
                <span class="text-muted ms-2">(@cart.TotalItems itens)</span>
            </li>

            <li><hr class="dropdown-divider"></li>

            @foreach (var item in cart.Items)
            {
                <li class="cart-item-dropdown">
                    <div class="d-flex align-items-center gap-3 px-3 py-2">
                        <div class="cart-dropdown-image">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid">
                            }
                            else
                            {
                                <i class="bi bi-box-seam"></i>
                            }
                        </div>

                        <div class="flex-grow-1">
                            <div class="cart-item-name">@item.Name</div>
                            <div class="cart-item-price">@item.Price.ToString("C")</div>
                            <div class="cart-item-quantity">Qtd: @item.Quantity</div>
                        </div>

                        <div class="cart-item-subtotal text-end">
                            <div class="fw-bold">@item.Subtotal.ToString("C")</div>
                            <button class="btn-remove-cart" onclick="removeFromCart(@item.Id)" title="Remover">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </li>

                <li><hr class="dropdown-divider m-0"></li>
            }

            <li class="dropdown-footer px-3 py-3">
                <div class="d-flex justify-content-between mb-2">
                    <strong>Total:</strong>
                    <strong class="text-primary">@cart.Total.ToString("C")</strong>
                </div>

                <div class="d-grid gap-2">
                    <a href="/Cart/Checkout" class="btn btn-success btn-sm">
                        <i class="bi bi-credit-card"></i> Proceder para Pagamento
                    </a>

                    <a href="/Cart/Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-cart"></i> Ver Carrinho Completo
                    </a>
                </div>
            </li>
        }
        else
        {
            <li class="text-center py-4 px-3">
                <i class="bi bi-cart-x fs-1 text-muted"></i>
                <p class="text-muted mb-0 mt-2">Seu carrinho está vazio</p>
                <a href="/Shop" class="btn btn-primary btn-sm mt-3">Continuar a comprar</a>
            </li>
        }
    </ul>
</div>

<script>
    async function removeFromCart(itemId) {
        const response = await fetch('/api/CartApi/remove', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ itemId: itemId })
        });

        if (response.ok) {
            location.reload();
        }
    }
</script>

<style>
    .cart-icon-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.4rem 0.75rem;
        border: 1px solid #dee2e6;
        border-radius: 999px;
        color: #212529;
        text-decoration: none;
        background: #ffffff;
    }

    .cart-icon-link:hover {
        background: #f8f9fa;
        color: #212529;
    }

    .cart-icon-link i {
        font-size: 1.25rem;
        line-height: 1;
    }

    .cart-icon-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.35rem;
        height: 1.35rem;
        padding: 0 0.35rem;
        border-radius: 999px;
        background: #dc3545;
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1;
    }

    .cart-dropdown-menu {
        width: 380px;
        max-height: 500px;
        overflow-y: auto;
        padding: 0;
    }

    .cart-dropdown-image {
        width: 50px;
        height: 50px;
        background: #f8f9fa;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .cart-dropdown-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cart-dropdown-image i {
        font-size: 1.5rem;
        color: #adb5bd;
    }

    .cart-item-name {
        font-size: 0.85rem;
        font-weight: 500;
        margin-bottom: 2px;
    }

    .cart-item-price {
        font-size: 0.75rem;
        color: #28a745;
    }

    .cart-item-quantity {
        font-size: 0.7rem;
        color: #6c757d;
    }

    .cart-item-subtotal {
        font-size: 0.85rem;
    }

    .btn-remove-cart {
        background: none;
        border: none;
        color: #dc3545;
        cursor: pointer;
        font-size: 0.8rem;
        margin-top: 4px;
    }

    .btn-remove-cart:hover {
        opacity: 0.7;
    }

    .cart-item-dropdown:hover {
        background-color: #f8f9fa;
    }

    .dropdown-header {
        background: #f8f9fa;
    }

    .dropdown-footer {
        background: #f8f9fa;
        border-top: 1px solid #e9ecef;
    }
</style>