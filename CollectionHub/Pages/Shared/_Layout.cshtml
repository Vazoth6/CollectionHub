@* Partial view partilhada utilizada para compor elementos comuns da interface. *@
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CollectionHub</title>

    <script type="importmap"></script>

    <link rel="icon" type="image/jpeg" href="~/images/logo.jpeg" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CollectionHub.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark main-navbar">
            <div class="container">

                <a class="navbar-brand brand-logo d-flex align-items-center gap-2"
                   asp-area=""
                   asp-page="/Index">

                    <img src="~/images/logo.jpeg"
                         asp-append-version="true"
                         alt="CollectionHub"
                         class="site-logo" />

                    <span>CollectionHub</span>

                </a>

                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Alternar navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1 gap-1">

                        <li class="nav-item">
                            <a class="nav-link nav-link-custom"
                               asp-area=""
                               asp-page="/Shop/Index">
                                <i class="bi bi-shop"></i> Loja
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom"
                                   asp-area=""
                                   asp-page="/Inventory/Index">
                                    <i class="bi bi-box-seam"></i> Inventário
                                </a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom"
                                   asp-area=""
                                   asp-page="/Admin/Index">
                                    <i class="bi bi-shield-lock"></i> Admin
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <partial name="_CartDropdown" />
                        <partial name="_LoginPartial" />
                    </div>

                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    &copy; 2026 - CollectionHub -
                    <a asp-area="" asp-page="/Privacy">Privacidade</a>
                </div>

                <div class="col-md-6 text-end">
                    <a asp-page="/About"
                       class="text-decoration-none text-muted">
                        <i class="bi bi-info-circle"></i> Sobre
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>