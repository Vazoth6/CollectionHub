@* Partial view partilhada utilizada para compor elementos comuns da interface. *@
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject CollectionHub.Data.ApplicationDbContext DbContext

<ul class="navbar-nav align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        // Obtém o IdentityUser atual
        var identityUser = await UserManager.GetUserAsync(User);
        // Obtém o MyUser correspondente
        var myUser = DbContext.MyUsers.FirstOrDefault(m => m.UserID == identityUser.Id);

        <li class="nav-item">
            <a class="nav-link auth-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Gerir perfil">
                <i class="bi bi-person-circle"></i>
                @(myUser?.Name ?? identityUser?.Email ?? "Utilizador")
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                <button type="submit" class="btn auth-btn-primary">
                    <i class="bi bi-box-arrow-right"></i> Sair
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link auth-link" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus"></i> Registar
            </a>
        </li>
        <li class="nav-item">
            <a class="btn auth-btn-primary" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </a>
        </li>
    }
</ul>