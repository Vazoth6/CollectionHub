@* Página Razor relacionada com o carrinho de compras e o processo de checkout. *@
@page "/Cart"
@model CollectionHub.Pages.Cart.IndexModel
@{
    ViewData["Title"] = "Carrinho completo";
}

<div class="container mt-4 cart-full-page">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">
                <i class="bi bi-cart3"></i> Carrinho completo
            </h1>
            <p class="text-muted mb-0">Revê os colecionáveis, ajusta quantidades e confirma o total antes do pagamento.</p>
        </div>
        <a asp-page="/Shop/Index" class="btn btn-outline-primary">
            <i class="bi bi-shop"></i> Continuar a comprar
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
    }

    @if (Model.Cart.Items.Any())
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <strong>Itens no carrinho</strong>
                        <span class="badge text-bg-secondary">@Model.Cart.TotalItems item(ns)</span>
                    </div>

                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="list-group-item p-3 p-md-4">
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-2">
                                        <div class="cart-full-image">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-box-seam"></i>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-5">
                                        <h5 class="fw-bold mb-1">@item.Name</h5>
                                        <div class="text-muted small mb-1">
                                            <i class="bi bi-person-circle"></i> Vendedor: @item.SellerName
                                        </div>
                                        <div class="small text-success fw-semibold">
                                            @item.Price.ToString("C") por unidade
                                        </div>
                                    </div>

                                    <div class="col-md-3">
                                        @* Formulário separado para permitir atualizar apenas a quantidade deste item. *@
                                        <form method="post" asp-page-handler="UpdateQuantity" class="d-flex align-items-center gap-2">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <label class="visually-hidden" for="quantity-@item.Id">Quantidade</label>
                                            <input id="quantity-@item.Id"
                                                   type="number"
                                                   name="quantity"
                                                   class="form-control form-control-sm cart-quantity-input"
                                                   value="@item.Quantity"
                                                   min="0"
                                                   max="99" />
                                            <button type="submit" class="btn btn-outline-secondary btn-sm" title="Atualizar quantidade">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <div class="col-md-2 text-md-end">
                                        <div class="fw-bold fs-5 mb-2">@item.Subtotal.ToString("C")</div>
                                        <form method="post" asp-page-handler="Remove">
                                            <input type="hidden" name="itemId" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Remover
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 cart-summary-card">
                    <div class="card-body">
                        <h5 class="card-title mb-4">
                            <i class="bi bi-receipt"></i> Resumo da compra
                        </h5>

                        <div class="d-flex justify-content-between mb-2">
                            <span>Total de itens:</span>
                            <strong>@Model.Cart.TotalItems</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <strong>@Model.Cart.Total.ToString("C")</strong>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-3">
                            <span>Entrega:</span>
                            <span>Definida no checkout</span>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold">Total:</span>
                            <strong class="text-primary fs-3">@Model.Cart.Total.ToString("C")</strong>
                        </div>

                        <a asp-page="/Cart/Checkout" class="btn btn-success btn-lg w-100 mb-2">
                            <i class="bi bi-credit-card"></i> Finalizar compra
                        </a>

                        <form method="post" asp-page-handler="Clear">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-trash"></i> Limpar carrinho
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">
                <i class="bi bi-cart-x display-1 text-muted"></i>
                <h4 class="mt-3">O carrinho está vazio</h4>
                <p class="text-muted">Adiciona colecionáveis da loja antes de finalizar a compra.</p>
                <a asp-page="/Shop/Index" class="btn btn-primary">
                    <i class="bi bi-shop"></i> Ir para a loja
                </a>
            </div>
        </div>
    }
</div>

@section Styles {
    <style>
        .cart-full-image {
            width: 100%;
            min-height: 110px;
            border-radius: 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .cart-full-image img {
            width: 100%;
            height: 110px;
            object-fit: contain;
            padding: 0.5rem;
        }

        .cart-full-image i {
            font-size: 2.75rem;
            color: #cbd5e1;
        }

        .cart-quantity-input {
            max-width: 90px;
        }

        .cart-summary-card {
            position: sticky;
            top: 95px;
        }

        @@media (max-width: 991.98px) {
            .cart-summary-card {
                position: static;
            }
        }
    </style>
}
