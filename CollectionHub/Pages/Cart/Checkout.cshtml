@page
@model CollectionHub.Pages.Cart.CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1 class="display-5 mb-4">
                <i class="bi bi-credit-card"></i> Checkout
            </h1>
            <hr />
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Cart.Items.Any())
    {
        <!-- Stepper / Progresso -->
        <div class="row mb-5">
            <div class="col-12">
                <div class="stepper-wrapper">
                    <div class="stepper-item @(Model.CurrentStep >= 1 ? "completed" : "") @(Model.CurrentStep == 1 ? "active" : "")">
                        <div class="step-counter">1</div>
                        <div class="step-name">Revisão do Pedido</div>
                    </div>
                    <div class="stepper-item @(Model.CurrentStep >= 2 ? "completed" : "") @(Model.CurrentStep == 2 ? "active" : "")">
                        <div class="step-counter">2</div>
                        <div class="step-name">Pagamento</div>
                    </div>
                    <div class="stepper-item @(Model.CurrentStep >= 3 ? "completed" : "") @(Model.CurrentStep == 3 ? "active" : "")">
                        <div class="step-counter">3</div>
                        <div class="step-name">Confirmação</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Passo 1: Revisão do Pedido -->
        @if (Model.CurrentStep == 1)
        {
            <form method="post" asp-page-handler="Next" id="step1Form">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-body">
                                <h5 class="card-title mb-4">
                                    <i class="bi bi-cart"></i> Itens do Pedido
                                </h5>
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Produto</th>
                                                <th>Preço</th>
                                                <th>Quantidade</th>
                                                <th>Subtotal</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Cart.Items)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-3">
                                                            <div class="checkout-item-image">
                                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                                {
                                                                    <img src="@item.ImageUrl" alt="@item.Name">
                                                                }
                                                                else
                                                                {
                                                                    <i class="bi bi-box-seam"></i>
                                                                }
                                                            </div>
                                                            <div>
                                                                <h6 class="mb-0">@item.Name</h6>
                                                                <small class="text-muted">Vendedor: @item.SellerName</small>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="align-middle">@item.Price.ToString("C")</td>
                                                    <td class="align-middle">@item.Quantity</td>
                                                    <td class="align-middle text-primary fw-bold">@item.Subtotal.ToString("C")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="card-title mb-4">
                                    <i class="bi bi-geo-alt"></i> Endereço de Entrega
                                </h5>
                                <div class="mb-3">
                                    <label asp-for="ShippingAddress" class="form-label fw-bold"></label>
                                    <textarea asp-for="ShippingAddress" class="form-control" rows="4"
                                              placeholder="Rua, Número, Andar, Cidade, Código Postal" required></textarea>
                                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Resumo do Pedido</h5>
                                @foreach (var item in Model.Cart.Items)
                                {
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>@item.Name <small class="text-muted">(x@(item.Quantity))</small></span>
                                        <span>@item.Subtotal.ToString("C")</span>
                                    </div>
                                }
                                <hr />
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal:</span>
                                    <span>@Model.Cart.Items.Sum(i => i.Subtotal).ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Envio:</span>
                                    <span class="text-success">Grátis</span>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between mb-4">
                                    <strong>Total:</strong>
                                    <strong class="text-primary fs-4">@Model.Cart.Total.ToString("C")</strong>
                                </div>
                                <button type="submit" class="btn btn-primary w-100 btn-lg">
                                    Próximo <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        }

        <!-- Passo 2: Pagamento -->
        @if (Model.CurrentStep == 2)
        {
            <form method="post" asp-page-handler="Payment" id="paymentForm">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">
                                <h5 class="card-title mb-4">
                                    <i class="bi bi-credit-card"></i> Método de Pagamento
                                </h5>

                                <!-- ⭐ SALDO DISPONÍVEL -->
                                <div class="alert alert-info mb-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-wallet2 fs-4 me-2"></i>
                                            <strong>Saldo disponível:</strong>
                                        </div>
                                        <span class="fs-4 fw-bold text-success">@Model.WalletBalance.ToString("C")</span>
                                    </div>
                                    <small class="text-muted">Este valor será deduzido da sua carteira virtual.</small>
                                </div>

                                <!-- ⭐ SALDO APÓS COMPRA -->
                                <div class="alert alert-secondary mb-4">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>Após a compra ficará com:</span>
                                        <span class="fw-bold @((Model.WalletBalance - Model.Cart.Total) >= 0 ? "text-success" : "text-danger")">
                                            @((Model.WalletBalance - Model.Cart.Total).ToString("C"))
                                        </span>
                                    </div>
                                </div>

                                <!-- ⭐ ENDEREÇO DE ENTREGA (READONLY + HIDDEN) -->
                                <div class="alert alert-light border mb-4">
                                    <strong><i class="bi bi-geo-alt"></i> Endereço de Entrega:</strong>
                                    <p class="mb-0 mt-1">@Model.ShippingAddress</p>
                                    <!-- ⭐ CAMPO HIDDEN PARA MANTER O ENDEREÇO -->
                                    <input type="hidden" asp-for="ShippingAddress" />
                                </div>

                                <div class="payment-methods">
                                    <!-- ⭐ CARTEIRA VIRTUAL (ATIVO) -->
                                    <div class="payment-option selected">
                                        <input type="radio" name="PaymentMethod" id="carteira" value="Carteira Virtual" checked>
                                        <label for="carteira">
                                            <div class="payment-icon" style="background: #d4edda;">
                                                <i class="bi bi-wallet2 text-success"></i>
                                            </div>
                                            <div class="payment-info">
                                                <strong>Carteira Virtual</strong>
                                                <small>Pague com o saldo da sua carteira</small>
                                            </div>
                                            <span class="badge bg-success">Disponível</span>
                                        </label>
                                    </div>

                                    <!-- ⭐ MBWAY (DESABILITADO) -->
                                    <div class="payment-option disabled">
                                        <input type="radio" name="PaymentMethod" id="mbway" value="MBWay" disabled>
                                        <label for="mbway" style="opacity: 0.6; cursor: not-allowed;">
                                            <div class="payment-icon" style="background: #f8f9fa;">
                                                <i class="bi bi-phone text-muted"></i>
                                            </div>
                                            <div class="payment-info">
                                                <strong>MBWay</strong>
                                                <small>Pague através do seu telemóvel</small>
                                            </div>
                                            <span class="badge bg-secondary">Em breve</span>
                                        </label>
                                    </div>

                                    <!-- ⭐ MULTIBANCO (DESABILITADO) -->
                                    <div class="payment-option disabled">
                                        <input type="radio" name="PaymentMethod" id="multibanco" value="Multibanco" disabled>
                                        <label for="multibanco" style="opacity: 0.6; cursor: not-allowed;">
                                            <div class="payment-icon" style="background: #f8f9fa;">
                                                <i class="bi bi-receipt text-muted"></i>
                                            </div>
                                            <div class="payment-info">
                                                <strong>Referência Multibanco</strong>
                                                <small>Gere uma referência para pagamento</small>
                                            </div>
                                            <span class="badge bg-secondary">Em breve</span>
                                        </label>
                                    </div>

                                    <!-- ⭐ CARTÃO DE CRÉDITO (DESABILITADO) -->
                                    <div class="payment-option disabled">
                                        <input type="radio" name="PaymentMethod" id="cartao" value="Cartao" disabled>
                                        <label for="cartao" style="opacity: 0.6; cursor: not-allowed;">
                                            <div class="payment-icon" style="background: #f8f9fa;">
                                                <i class="bi bi-credit-card text-muted"></i>
                                            </div>
                                            <div class="payment-info">
                                                <strong>Cartão de Crédito</strong>
                                                <small>Visa, Mastercard, American Express</small>
                                            </div>
                                            <span class="badge bg-secondary">Em breve</span>
                                        </label>
                                    </div>
                                </div>

                                <input type="hidden" name="paymentMethod" value="Carteira Virtual" />

                                <div class="mt-3 text-muted small">
                                    <i class="bi bi-info-circle"></i>
                                    Outros métodos de pagamento estarão disponíveis em breve.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Resumo do Pedido</h5>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Total:</span>
                                    <strong class="text-primary fs-4">@Model.Cart.Total.ToString("C")</strong>
                                </div>
                                <hr />
                                <div class="d-flex gap-2">
                                    <button type="button" onclick="goBack()" class="btn btn-outline-secondary w-50">
                                        <i class="bi bi-arrow-left"></i> Voltar
                                    </button>
                                    <button type="submit" class="btn btn-success w-50"
                                        @(Model.WalletBalance < Model.Cart.Total ? "disabled" : "")>
                                        Finalizar Compra <i class="bi bi-check-circle"></i>
                                    </button>
                                </div>
                                @if (Model.WalletBalance < Model.Cart.Total)
                                {
                                    <small class="text-danger d-block mt-2">
                                        <i class="bi bi-exclamation-triangle"></i> Saldo insuficiente
                                    </small>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        }

        <!-- Passo 3: Confirmação -->
        @if (Model.CurrentStep == 3)
        {
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <div class="card shadow-sm border-0 text-center p-4">
                        <div class="confirmation-icon">
                            <i class="bi bi-check-circle-fill text-success"></i>
                        </div>
                        <h2 class="mt-4">Pedido Confirmado!</h2>
                        <p class="text-muted">Obrigado pela sua compra. O seu pedido foi processado com sucesso.</p>

                        <div class="order-details text-start mt-4">
                            <h5>Resumo do Pedido</h5>
                            <hr />
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex justify-content-between mb-2">
                                    <span>@item.Name (x@(item.Quantity))</span>
                                    <span>@item.Subtotal.ToString("C")</span>
                                </div>
                            }
                            <hr />
                            <div class="d-flex justify-content-between mb-2">
                                <strong>Total Pago:</strong>
                                <strong class="text-primary fs-5">@Model.Cart.Total.ToString("C")</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Método de Pagamento:</span>
                                <span>@Model.PaymentMethod</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Endereço de Entrega:</span>
                                <span class="text-end">@Model.ShippingAddress</span>
                            </div>
                        </div>

                        <hr />
                        <div class="d-flex gap-3">
                            <a href="/Shop" class="btn btn-primary flex-grow-1">
                                <i class="bi bi-shop"></i> Continuar Comprando
                            </a>
                            <a href="/Inventory" class="btn btn-outline-secondary flex-grow-1">
                                <i class="bi bi-box-seam"></i> Ver Inventário
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x fs-1 text-muted"></i>
            <h3 class="mt-3">O seu carrinho está vazio</h3>
            <p class="text-muted">Adicione itens ao carrinho para continuar.</p>
            <a href="/Shop" class="btn btn-primary mt-3">Continuar a Comprar</a>
        </div>
    }
</div>

@section Styles {
    <style>
        .stepper-wrapper {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .stepper-item {
            flex: 1;
            text-align: center;
            position: relative;
        }

            .stepper-item:not(:last-child):before {
                content: '';
                position: absolute;
                top: 20px;
                left: 50%;
                width: 100%;
                height: 2px;
                background: #e0e0e0;
                z-index: 1;
            }

            .stepper-item.completed:not(:last-child):before {
                background: #28a745;
            }

        .step-counter {
            width: 40px;
            height: 40px;
            background: #e0e0e0;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            position: relative;
            z-index: 2;
            margin-bottom: 10px;
        }

        .stepper-item.completed .step-counter {
            background: #28a745;
            color: white;
        }

        .stepper-item.active .step-counter {
            background: #667eea;
            color: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.3);
        }

        .step-name {
            font-size: 14px;
            color: #6c757d;
        }

        .stepper-item.active .step-name {
            color: #667eea;
            font-weight: 600;
        }

        .stepper-item.completed .step-name {
            color: #28a745;
        }

        .checkout-item-image {
            width: 60px;
            height: 60px;
            background: #f8f9fa;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .checkout-item-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .checkout-item-image i {
                font-size: 1.8rem;
                color: #adb5bd;
            }

        .payment-option {
            border: 2px solid #e9ecef;
            border-radius: 12px;
            margin-bottom: 15px;
            transition: all 0.2s;
        }

            .payment-option.selected {
                border-color: #28a745;
                background: #f0fff4;
            }

            .payment-option.disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

                .payment-option.disabled label {
                    cursor: not-allowed;
                }

            .payment-option input[type="radio"] {
                display: none;
            }

            .payment-option label {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 15px;
                cursor: pointer;
                margin: 0;
            }

            .payment-option.disabled label {
                cursor: not-allowed;
            }

        .payment-icon {
            width: 50px;
            height: 50px;
            background: #f8f9fa;
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }

        .payment-info {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

            .payment-info small {
                font-size: 0.75rem;
                color: #6c757d;
            }

        .payment-option .badge {
            font-size: 0.7rem;
            padding: 4px 10px;
        }

        .confirmation-icon i {
            font-size: 5rem;
        }

        .order-details {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
        }

        .sticky-top {
            position: sticky;
            top: 20px;
        }
    </style>
}

@section Scripts {
    <script>
        function goBack() {
            window.location.href = '/Cart/Checkout?step=1';
        }

        // ⭐ CLICK NAS OPÇÕES DE PAGAMENTO
        document.querySelectorAll('.payment-option:not(.disabled)').forEach(option => {
            option.addEventListener('click', function() {
                const radio = this.querySelector('input[type="radio"]');
                if (radio) {
                    radio.checked = true;
                    document.querySelectorAll('.payment-option').forEach(opt => opt.classList.remove('selected'));
                    this.classList.add('selected');
                }
            });
        });

        // ⭐ VALIDAÇÃO ANTES DE SUBMETER
        document.getElementById('paymentForm')?.addEventListener('submit', function(e) {
            console.log('Submetendo formulário de pagamento...');
            // O formulário vai ser submetido normalmente
        });

        document.getElementById('step1Form')?.addEventListener('submit', function(e) {
            const address = document.querySelector('textarea[name="ShippingAddress"]');
            if (address && !address.value.trim()) {
                e.preventDefault();
                alert('Por favor, preencha o endereço de entrega.');
                address.focus();
                return false;
            }
            return true;
        });
    </script>
}