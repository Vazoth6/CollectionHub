@* Página Razor da área de identidade, usada para autenticação e gestão da conta do utilizador. *@
@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirme o seu email";
}

<div class="auth-page py-5">
    <div class="auth-card mx-auto text-center">
        <div class="auth-icon mx-auto mb-3"><i class="bi bi-envelope-check"></i></div>
        <h1 class="h3 mb-2">Confirme o seu email</h1>
        <p class="text-muted mb-4">
            Enviámos uma mensagem para <strong>@Model.Email</strong>. Abra o link recebido para ativar a sua conta.
        </p>

        @if (Model.DisplayConfirmAccountLink)
        {
            <div class="alert alert-warning text-start">
                <strong>Modo de desenvolvimento:</strong> como o SMTP ainda não está configurado, pode confirmar a conta por este link temporário.
            </div>
            <a id="confirm-link" class="btn auth-btn-primary w-100" href="@Model.EmailConfirmationUrl">
                <i class="bi bi-check-circle"></i> Confirmar conta
            </a>
        }
        else
        {
            <a class="btn auth-btn-primary w-100" asp-page="./Login">Ir para login</a>
        }
    </div>
</div>
