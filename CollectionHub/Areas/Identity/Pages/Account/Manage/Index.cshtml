@page
@model IndexModel
@{
    ViewData["Title"] = "Meu Perfil";
}

<h1 class="display-5 mb-4">
    <i class="bi bi-person-circle text-primary"></i> Meu Perfil
</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form id="profile-form" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Nome -->
                    <div class="mb-3">
                        <label asp-for="Input.Name" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="Input.Name" class="form-control" />
                        </div>
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>

                    <!-- Email (somente leitura) -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="Input.Email" class="form-control" disabled />
                        </div>
                    </div>

                    <!-- Telemóvel -->
                    <div class="mb-3">
                        <label asp-for="Input.CellPhone" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="Input.CellPhone" class="form-control" placeholder="+351 912 345 678" />
                        </div>
                        <span asp-validation-for="Input.CellPhone" class="text-danger"></span>
                        <small class="text-muted">Exemplo: +351912345678 ou 912345678</small>
                    </div>

                    <!-- Cargo (somente leitura) -->
                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="Input.Role" class="form-control" disabled />
                        </div>
                    </div>

                    <!-- Saldo (carteira virtual) -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Saldo Disponível</label>
                        <div class="alert alert-success">
                            <h4 class="mb-0">@Model.Input.WalletBalance.ToString("C")</h4>
                        </div>
                    </div>

                    <!-- Alterar Palavra-Chave -->
                    <!--<div class="mb-3">
                        <label class="form-label fw-bold"><i class="bi bi-key"></i> Alterar Password</label>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" asp-for="Input.ChangePassword" id="changePasswordCheck">
                            <label class="form-check-label" for="changePasswordCheck">
                                Pretendo alterar a minha password
                            </label>
                        </div>

                        <div id="passwordFields" style="display: none;">
                            <div class="mt-3">
                                <div class="mb-3">
                                    <label asp-for="Input.NewPassword" class="form-label"></label>
                                    <input asp-for="Input.NewPassword" class="form-control" />
                                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Input.ConfirmNewPassword" class="form-label"></label>
                                    <input asp-for="Input.ConfirmNewPassword" class="form-control" />
                                    <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>-->


                    <div class="d-flex justify-content-between">
                        <a asp-page="/Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Guardar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>    
</div>

@section Styles {
    <style>
        .input-group-text {
            background: #f8f9fa;
            min-width: 40px;
            justify-content: center;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mostrar/esconder campos de password
        document.getElementById('changePasswordCheck').addEventListener('change', function() {
            document.getElementById('passwordFields').style.display = this.checked ? 'block' : 'none';
        });

        // Inicializar estado
        document.addEventListener('DOMContentLoaded', function() {
            const checkbox = document.getElementById('changePasswordCheck');
            if (checkbox && checkbox.checked) {
                document.getElementById('passwordFields').style.display = 'block';
            }
        });
    </script>
}