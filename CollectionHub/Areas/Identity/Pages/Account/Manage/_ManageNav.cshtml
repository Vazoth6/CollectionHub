@* Página Razor da área de identidade, usada para autenticação e gestão da conta do utilizador. *@
@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<ul class="nav nav-pills flex-column gap-1">
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
            <i class="bi bi-person"></i> Perfil
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
            <i class="bi bi-envelope"></i> Email
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
            <i class="bi bi-key"></i> Palavra-Passe
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
            <i class="bi bi-database"></i> Dados Pessoais
        </a>
    </li>
</ul>

<style>
    .nav-pills .nav-link {
        border-radius: 10px;
        padding: 0.6rem 1rem;
        transition: all 0.2s ease;
        color: #495057;
    }

        .nav-pills .nav-link:hover {
            background: #f1f3f5;
            color: #1e293b;
        }

        .nav-pills .nav-link i {
            margin-right: 0.5rem;
            font-size: 1.1rem;
        }

        .nav-pills .nav-link.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
        }

            .nav-pills .nav-link.active i {
                color: white;
            }
</style>