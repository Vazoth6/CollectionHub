@* Página Razor da área de identidade, usada para autenticação e gestão da conta do utilizador. *@
@page
@model EmailModel
@{
    ViewData["Title"] = "Gerir Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
    <div>
        <h1 class="display-5 mb-2">
            <i class="bi bi-envelope text-primary"></i>
            @ViewData["Title"]
        </h1>
        <p class="text-muted mb-0">
            Altere o seu endereço de email e verifique a sua conta.
        </p>
    </div>
</div>

<hr class="mb-4" />

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <h5 class="card-title mb-4">
                    <i class="bi bi-envelope text-primary"></i>
                    Dados do email
                </h5>

                <form id="email-form" method="post">

                    <!-- Email atual -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email Atual</label>
                        <div class="input-group">
                            <input asp-for="Email" class="form-control" disabled />
                            @if (Model.IsEmailConfirmed)
                            {
                                <span class="input-group-text bg-success text-white border-success">
                                    <i class="bi bi-check-circle"></i> Confirmado
                                </span>
                            }
                            else
                            {
                                <span class="input-group-text bg-warning text-dark border-warning">
                                    <i class="bi bi-exclamation-triangle"></i> Não confirmado
                                </span>
                            }
                        </div>
                        @if (!Model.IsEmailConfirmed)
                        {
                            <div class="mt-2">
                                <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail"
                                        class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-envelope-paper"></i> Reenviar email de verificação
                                </button>
                            </div>
                        }
                    </div>

                    <hr />

                    <!-- Novo email -->
                    <div class="mb-3">
                        <label asp-for="Input.NewEmail" class="form-label fw-semibold">Novo Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Input.NewEmail" class="form-control"
                                   autocomplete="email" aria-required="true"
                                   placeholder="Digite o novo email" />
                        </div>
                        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
                    </div>

                    <!-- Confirmar email -->
                    <div class="mb-4">
                        <label asp-for="Input.ConfirmEmail" class="form-label fw-semibold">Confirmar Novo Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Input.ConfirmEmail" class="form-control"
                                   autocomplete="email" aria-required="true"
                                   placeholder="Confirme o novo email" />
                        </div>
                        <span asp-validation-for="Input.ConfirmEmail" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Voltar ao perfil
                        </a>
                        <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Guardar alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 bg-info bg-opacity-10 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h6 class="text-muted mb-2">Email</h6>
                        <h5 class="mb-3 text-info">Recomendações</h5>
                    </div>
                    <i class="bi bi-info-circle fs-1 text-info"></i>
                </div>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Após alterar o email, será necessário confirmar o novo endereço.</li>
                    <li>Se não receber o email de verificação, verifique a pasta de spam.</li>
                    <li>Certifique-se de que o novo email está correto antes de confirmar.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .input-group .form-control {
            border-radius: 0.375rem 0 0 0.375rem;
        }

        .input-group .btn-outline-secondary {
            border-radius: 0 0.375rem 0.375rem 0;
        }

        .input-group-text.bg-success {
            background: #28a745 !important;
            color: white !important;
            border-color: #28a745 !important;
        }

        .input-group-text.bg-warning {
            background: #ffc107 !important;
            color: #212529 !important;
            border-color: #ffc107 !important;
        }

        .input-group-text {
            background: #f8f9fa;
            min-width: 42px;
            justify-content: center;
        }

        .input-group .form-control:disabled {
            background-color: #f8f9fa;
            opacity: 0.8;
        }

        .btn-outline-warning {
            border-color: #ffc107;
            color: #856404;
        }

        .btn-outline-warning:hover {
            background: #ffc107;
            color: #212529;
        }

        .card {
            border-radius: 16px;
            overflow: hidden;
        }

        .card-body {
            padding: 1.75rem;
        }

        hr {
            opacity: 0.15;
            margin: 1.5rem 0;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // VALIDAÇÃO EM TEMPO REAL PARA CONFIRMAR EMAIL
        document.addEventListener('DOMContentLoaded', function() {
            const newEmail = document.getElementById('Input_NewEmail');
            const confirmEmail = document.getElementById('Input_ConfirmEmail');

            if (newEmail && confirmEmail) {
                confirmEmail.addEventListener('input', function() {
                    if (this.value && newEmail.value !== this.value) {
                        this.classList.add('is-invalid');
                        let errorMsg = this.parentElement.parentElement.querySelector('.text-danger');
                        if (!errorMsg) {
                            errorMsg = document.createElement('span');
                            errorMsg.className = 'text-danger';
                            errorMsg.textContent = 'Os emails não coincidem.';
                            this.parentElement.parentElement.appendChild(errorMsg);
                        }
                    } else {
                        this.classList.remove('is-invalid');
                        const errorMsg = this.parentElement.parentElement.querySelector('.text-danger');
                        if (errorMsg && errorMsg.textContent.includes('não coincidem')) {
                            errorMsg.remove();
                        }
                    }
                });
            }
        });
    </script>
}