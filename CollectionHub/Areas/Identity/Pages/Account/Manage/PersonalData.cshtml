@* Página Razor da área de identidade, usada para autenticação e gestão da conta do utilizador. *@
@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados Pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
    <div>
        <h1 class="display-5 mb-2">
            <i class="bi bi-database text-primary"></i>
            @ViewData["Title"]
        </h1>
        <p class="text-muted mb-0">
            Consulte, descarregue ou elimine os dados associados ao seu perfil.
        </p>
    </div>
</div>

<hr class="mb-4" />

<div class="alert alert-info shadow-sm border-0" role="alert">
    <i class="bi bi-info-circle"></i>
    Esta página contém os dados pessoais que armazenamos sobre a sua conta.
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-primary bg-opacity-10 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h6 class="text-muted mb-1">Exportação</h6>
                        <h3 class="mb-0 text-primary">Descarregar dados</h3>
                    </div>
                    <i class="bi bi-download fs-1 text-primary"></i>
                </div>
                <p class="text-muted small flex-grow-1">
                    Obtenha uma cópia dos seus dados pessoais em formato JSON.
                </p>
                <form id="download-data" asp-page="DownloadPersonalData" method="post">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-download"></i> Descarregar dados
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm border-0 bg-danger bg-opacity-10 h-100">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h6 class="text-muted mb-1">Conta</h6>
                        <h3 class="mb-0 text-danger">Eliminar conta</h3>
                    </div>
                    <i class="bi bi-trash fs-1 text-danger"></i>
                </div>
                <p class="text-muted small flex-grow-1">
                    Elimine permanentemente a sua conta e os dados associados à plataforma.
                </p>
                <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash"></i> Eliminar conta
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-shield-check fs-2 text-success"></i>
            <div>
                <h6 class="mb-1">Proteção dos dados</h6>
                <p class="text-muted small mb-0">Os seus dados são tratados com segurança e apenas para funcionamento da plataforma.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle"></i> Confirmar eliminação
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="delete-user" method="post">
                <div class="modal-body">
                    <p>
                        Tem a certeza que deseja <strong>eliminar permanentemente</strong> a sua conta?
                    </p>
                    <ul class="text-muted small">
                        <li>Todos os seus dados pessoais serão eliminados.</li>
                        <li>Os itens que colocou à venda serão removidos.</li>
                        <li>O histórico de transações será removido.</li>
                        <li>Esta ação não pode ser desfeita.</li>
                    </ul>
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle"></i>
                        Digite <strong>ELIMINAR</strong> para confirmar.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="confirmDelete">Confirmação</label>
                        <input type="text" class="form-control" id="confirmDelete"
                               placeholder="Digite ELIMINAR" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger" id="deleteConfirmBtn" disabled>
                        <i class="bi bi-trash"></i> Confirmar eliminação
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('confirmDelete').addEventListener('input', function() {
            const btn = document.getElementById('deleteConfirmBtn');
            btn.disabled = this.value !== 'ELIMINAR';
        });

        document.getElementById('deleteConfirmBtn').addEventListener('click', function(e) {
            e.preventDefault();
            const confirmInput = document.getElementById('confirmDelete');
            if (confirmInput.value === 'ELIMINAR') {
                if (confirm('Tem a certeza absoluta que deseja eliminar a sua conta? Esta ação é irreversível.')) {
                    document.getElementById('delete-user').submit();
                }
            }
        });
    </script>
}
