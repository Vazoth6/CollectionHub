@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar Palavra-Passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
    <div>
        <h1 class="display-5 mb-2">
            <i class="bi bi-key text-primary"></i>
            @ViewData["Title"]
        </h1>
        <p class="text-muted mb-0">
            Atualize a palavra-passe da sua conta de forma segura.
        </p>
    </div>
</div>

<hr class="mb-4" />

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body p-4">
                <h5 class="card-title mb-4">
                    <i class="bi bi-shield-lock text-primary"></i>
                    Dados da nova palavra-passe
                </h5>

                <form id="change-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.OldPassword" class="form-label fw-semibold">Palavra-passe atual</label>
                        <div class="input-group">
                            <input asp-for="Input.OldPassword" class="form-control"
                                   autocomplete="current-password" aria-required="true"
                                   placeholder="Digite a palavra-passe atual" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword(this, 'OldPassword')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label fw-semibold">Nova palavra-passe</label>
                        <div class="input-group">
                            <input asp-for="Input.NewPassword" class="form-control"
                                   autocomplete="new-password" aria-required="true"
                                   placeholder="Digite a nova palavra-passe" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword(this, 'NewPassword')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                        <small class="text-muted d-block mt-2">
                            <i class="bi bi-info-circle"></i>
                            A palavra-passe deve ter pelo menos 8 caracteres.
                        </small>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirmar nova palavra-passe</label>
                        <div class="input-group">
                            <input asp-for="Input.ConfirmPassword" class="form-control"
                                   autocomplete="new-password" aria-required="true"
                                   placeholder="Confirme a nova palavra-passe" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword(this, 'ConfirmPassword')">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <a asp-page="./Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Voltar ao perfil
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Guardar alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 bg-success bg-opacity-10 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                        <h6 class="text-muted mb-2">Segurança</h6>
                        <h5 class="mb-3 text-success">Recomendações</h5>
                    </div>
                    <i class="bi bi-shield-check fs-1 text-success"></i>
                </div>
                <ul class="small text-muted mb-0 ps-3">
                    <li>Utilize uma palavra-passe única.</li>
                    <li>Combine letras, números e símbolos.</li>
                    <li>Evite dados pessoais óbvios.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .input-group .form-control {
            border-radius: 0.375rem 0 0 0.375rem;
        }

        .input-group .btn-outline-secondary {
            border-radius: 0 0.375rem 0.375rem 0;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(button, inputId) {
            const input = document.getElementById(inputId);
            const icon = button.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}
