@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmação";
}

<div class="auth-page py-5">
    <div class="auth-card mx-auto">
        <div class="auth-icon mx-auto mb-3"><i class="bi bi-send"></i></div>
        <h1 class="h3 text-center mb-2">Reenviar confirmação</h1>
        <p class="text-muted text-center mb-4">
            Indique o email da conta para receber um novo link de confirmação.
            <br />
            <small class="text-warning">
                <i class="bi bi-info-circle"></i>
                Se preferir, um administrador pode confirmar o seu email através do painel de administração.
            </small>
        </p>
        <partial name="_StatusMessage" model="Model.StatusMessage" />
        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="nome@exemplo.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn auth-btn-primary w-100">
                <i class="bi bi-envelope"></i> Enviar link
            </button>
        </form>
        <hr class="my-4" />
        <p class="text-center small text-muted">
            Precisa de ajuda? <a href="/Admin" target="_blank">Contacte um administrador</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}